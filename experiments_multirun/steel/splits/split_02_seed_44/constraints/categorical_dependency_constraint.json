{
  "dsl_version": "2.0",
  "constraints": [
    {
      "id": "day_of_week_determines_week_status",
      "description": "Day of week determines whether the interval is a weekday or weekend.",
      "rationale": "Calendar semantics make WeekStatus a deterministic function of Day_of_week: Monday through Friday are Weekday, while Saturday and Sunday are Weekend.",
      "determinants": [
        "Day_of_week"
      ],
      "dependent": "WeekStatus",
      "value_table": [
        {
          "determinant_values": [
            [
              "Friday",
              "Monday",
              "Thursday",
              "Tuesday",
              "Wednesday"
            ]
          ],
          "dependent_values": [
            "Weekday"
          ]
        },
        {
          "determinant_values": [
            [
              "Saturday",
              "Sunday"
            ]
          ],
          "dependent_values": [
            "Weekend"
          ]
        }
      ],
      "support": 1.0,
      "violation_rate": 0.0
    }
  ]
}
